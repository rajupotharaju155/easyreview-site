# Vite loads env by mode:
#   .env.development  → npm run dev
#   .env.staging      → npm run build -- --mode staging
#   .env.production   → npm run build
#
# Local overrides (gitignored): .env.*.local

VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_MAPS_API_KEY=

# Analytics — leave empty locally so dev traffic isn't tracked
VITE_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=
VITE_CLARITY_ID=
